@startuml AppArchitecture
!include style.puml
!pragma layout smetana
allowmixing
top to bottom direction
skinparam componentStyle rectangle
skinparam nodesep 30
skinparam ranksep 40

component "Main" as Startup
component "AppLogging\nRotating logs" as Logging
component "Coordination\nEqmManager, BackupHandler" as Manager
component "Parser" as Input
component "Help" as Help

component "Loans\nLoanHandler" as Loans
component "Equipment\nEquipmentHandler" as Equipment
component "Bundles\nBundleHandler" as Bundles
component "Maintenance\nMaintenanceHandler" as Maintenance

component "File storage\nEquipmentStorage, BundleStorage\nLoanStorage, LoanReturnStorage\nMaintenanceStorage" as Storage
artifact "Data files (data/)\nequipment.txt, bundles.txt\nloans.txt, loan-sequence.txt\nmaintenance.txt" as Files

Startup ..> Manager : starts
Startup .right.> Logging : starts / closes
Manager .left.> Input : reads input
Manager .right.> Help : displays help
Manager ..> Loans
Manager ..> Equipment
Manager ..> Bundles
Manager ..> Maintenance
Loans .right.> Equipment : inventory
Bundles .left.> Equipment : inventory
Maintenance ..> Equipment : identity lookup
Equipment ..> Storage : loads / saves
Loans ..> Storage : loads / saves
Bundles ..> Storage : loads / saves
Maintenance ..> Storage : loads / saves
Storage ..> Files : reads / writes

legend bottom left
Arrows show dependencies, not execution order.
endlegend
@enduml
