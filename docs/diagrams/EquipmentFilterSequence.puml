@startuml EquipmentFilterSequence
!include style.puml
hide footbox
skinparam sequenceMessageAlign center
skinparam maxMessageSize 150
skinparam defaultFontSize 16
skinparam participantFontSize 14
skinparam ParticipantPadding 5

title filter type/camera cond/1-3 status/available

participant ":EqmManager" as Manager
participant "EquipmentFilter" as Parsing <<class>>
participant "filter:\nEquipmentFilter" as Filter
participant ":LoanHandler" as Loans

Manager -> Parsing : parse(input)
activate Parsing
Parsing --> Manager : filter
deactivate Parsing
Manager -> Manager : read inventory
Manager -> Filter : apply(inventory, loans)
activate Filter
loop each item
    Filter -> Loans : hasActiveLoanForItem(...)
    activate Loans
    Loans --> Filter : isLoaned
    deactivate Loans
    Filter -> Filter : matches(item, isLoaned)
end
Filter --> Manager : matches
deactivate Filter
alt no matches
    Manager -> Manager : display no-results message
else matches found
    Manager -> Manager : display matches
end
@enduml
