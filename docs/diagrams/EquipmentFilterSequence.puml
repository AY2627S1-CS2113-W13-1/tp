@startuml EquipmentFilterSequence
!include style.puml
hide footbox
skinparam sequenceMessageAlign center
skinparam maxMessageSize 200

title filter type/camera cond/1-3 status/available

participant ":EqmManager" as Manager
participant "EquipmentFilter" as Parsing <<class>>
participant "filter:EquipmentFilter" as Filter
participant ":LoanHandler" as Loans
participant ":EquipmentHandler" as Inventory

Manager -> Parsing : parse(input)
activate Parsing
Parsing --> Manager : validated filter
deactivate Parsing
Manager -> Inventory : getEquipmentList()
activate Inventory
Inventory --> Manager : inventory view
deactivate Inventory
Manager -> Filter : apply(inventory, loans)
activate Filter
loop each item, in inventory order
    Filter -> Loans : hasActiveLoanForItem(itemId)
    activate Loans
    Loans --> Filter : isLoaned
    deactivate Loans
    Filter -> Filter : matches(item, isLoaned)
end
Filter --> Manager : unmodifiable list of matching items
deactivate Filter
alt no matches
    Manager -> Manager : display no-results message
else matches found
    Manager -> Inventory : viewEquipment(matches)
    activate Inventory
    Inventory --> Manager
    deactivate Inventory
end
@enduml
