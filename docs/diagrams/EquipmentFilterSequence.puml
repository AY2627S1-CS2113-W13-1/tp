@startuml EquipmentFilterSequence
!include style.puml
hide footbox
skinparam sequenceMessageAlign center
skinparam maxMessageSize 150
skinparam defaultFontSize 16
skinparam participantFontSize 14

title eqm-filter type/camera cond/1-3 status/available

participant ":EqmManager" as Manager
participant ":EquipmentHandler" as Inventory
participant "EquipmentFilter" as Parsing <<class>>
participant "filter:\nEquipmentFilter" as Filter
participant ":LoanHandler" as Loans

Manager -> Parsing : parse(input)
activate Parsing
note right of Parsing
EquipmentFields.parse(...)
extracts criteria map
end note
create Filter
Parsing -> Filter : new(fields)
activate Filter
Filter -> Filter : validate()
Filter --> Parsing : validated filter
deactivate Filter
Parsing --> Manager : filter
deactivate Parsing
Manager -> Inventory : getEquipmentList()
activate Inventory
Inventory --> Manager : inventory
deactivate Inventory
Manager -> Filter : apply(inventory, loans)
activate Filter
loop each item
    Filter -> Loans : hasActiveLoanForItem(...)
    activate Loans
    Loans --> Filter : isLoaned
    deactivate Loans
    Filter -> Filter : matches(item, isLoaned)
end
Filter --> Manager : matches
deactivate Filter
Manager -> Inventory : viewEquipment(matches)
activate Inventory
Inventory --> Manager
deactivate Inventory
@enduml
